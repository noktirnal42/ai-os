#!/usr/bin/env python3
"""Resolve an allowlisted host and make a bounded HTTP HEAD request."""
import json
import os
import sys
import urllib.error
import urllib.request
from netlib import opener, resolve, validate_url

def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} http(s)://allowlisted-host[:port]/path", file=sys.stderr)
        return 2
    if os.environ.get("AIOS_ALLOW_NETWORK") != "1":
        print("network disabled: set AIOS_ALLOW_NETWORK=1 after the operator gate", file=sys.stderr)
        return 4
    try:
        parsed = validate_url(sys.argv[1])
        port = parsed.port or (443 if parsed.scheme == "https" else 80)
        addresses = resolve(parsed.hostname, port)
        request = urllib.request.Request(sys.argv[1], method="HEAD", headers={"User-Agent": "aios-netcheck/0.1"})
        with opener().open(request, timeout=5) as response:
            status = response.status
        print(json.dumps({"host": parsed.hostname, "port": port, "addresses": addresses, "http_status": status}, sort_keys=True))
        return 0
    except (ValueError, OSError, urllib.error.URLError, TimeoutError) as exc:
        print(f"network check failed: {exc}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    raise SystemExit(main())
