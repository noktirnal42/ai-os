#!/usr/bin/env python3
"""Bounded Phase 2 HTTP fetch; opt-in and allowlist constrained."""
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from netlib import opener, validate_url

MAX_BYTES = 65536
TIMEOUT = 10

def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} https://host/path", file=sys.stderr)
        return 2
    if os.environ.get("AIOS_ALLOW_NETWORK") != "1":
        print("network disabled: set AIOS_ALLOW_NETWORK=1 after the operator gate", file=sys.stderr)
        return 4
    try:
        validate_url(sys.argv[1])
    except ValueError:
        print("fetch rejected: scheme, credentials, or host is outside the allowlist", file=sys.stderr)
        return 3
    try:
        request = urllib.request.Request(sys.argv[1], headers={"User-Agent": "aios-fetch/0.1"})
        with opener().open(request, timeout=TIMEOUT) as response:
            body = response.read(MAX_BYTES + 1)
            if len(body) > MAX_BYTES:
                print("fetch rejected: response exceeds 64 KiB", file=sys.stderr)
                return 5
            sys.stdout.buffer.write(body)
            return 0
    except (urllib.error.URLError, TimeoutError, ValueError) as exc:
        print(f"fetch failed: {exc}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    raise SystemExit(main())
