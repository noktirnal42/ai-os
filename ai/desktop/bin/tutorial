#!/bin/sh
# Guided first app: build "notes" step by step, test it, and install it through the approval gate.
# Interactive by default. TUTORIAL_NONINTERACTIVE=1 runs the build and test without pauses or install.
set -eu
TPL=/ai/desktop/tutorial/notes
APP=/ai/apps/notes
NONI="${TUTORIAL_NONINTERACTIVE:-0}"

pause() {
  [ "$NONI" = 1 ] && return 0
  printf '\n  [Enter] to continue, Ctrl-C to stop: '
  read -r _ || true
  echo
}
step() { printf '\n== %s\n\n' "$1"; }

step "Step 1 of 5: what an app is"
cat <<'TXT'
  An AI OS app has three parts:
    entry     the command you run (here: /ai/bin/notes)
    tests     an acceptance test that must pass before the app is installed
    manifest  a small file that names the app, its version, and its capabilities
  Capabilities say what the app may touch. This app uses fs:/ai/state (its notes file).
TXT
echo; echo "  manifest.json:"; sed 's/^/    /' "$TPL/manifest.json"
pause

step "Step 2 of 5: create the app"
mkdir -p "$APP/tests"
cp "$TPL/manifest.json" "$APP/manifest.json"
cp "$TPL/notes.sh" "$APP/notes.sh"
cp "$TPL/tests/run.sh" "$APP/tests/run.sh"
chmod +x "$APP/notes.sh" "$APP/tests/run.sh"
printf '#!/bin/sh\nexec sh /ai/apps/notes/notes.sh "$@"\n' > /tmp/notes-wrapper
sudo install -m 755 /tmp/notes-wrapper /ai/bin/notes
echo "  Created $APP and the entry /ai/bin/notes."
echo; echo "  The app itself (notes.sh):"; sed 's/^/    /' "$APP/notes.sh"
pause

step "Step 3 of 5: run the acceptance test"
echo "  The test adds notes to a private file, then checks list, search, and bad input."
if sh "$APP/tests/run.sh"; then
  echo "  Test passed."
else
  echo "  Test failed. Fix notes.sh and run: sh $APP/tests/run.sh"
  exit 1
fi
pause

step "Step 4 of 5: install through the approval gate"
if [ "$NONI" = 1 ]; then
  echo "  Skipped in non-interactive mode. Install needs your answer."
else
  echo "  AI OS asks you before it registers any app. Read the prompt, then answer y or n."
  pause
  /ai/bin/aios registry install notes || echo "  Not installed. You can run this again later."
fi
pause

step "Step 5 of 5: use it"
if [ "$NONI" = 1 ]; then
  echo "  Skipped in non-interactive mode."
else
  echo "  Try these in any terminal:"
  echo "    notes add buy milk"
  echo "    notes list"
  echo "    notes search milk"
fi
echo
echo "  Tutorial done. Next app idea: a calculator with a test (Alt+w shows the key list)."
